# 6. Sales Forecasting (ARIMA)

## forecasting.py

```python
import pandas as pd

from statsmodels.tsa.arima.model import ARIMA

df = pd.read_csv(
    "data/processed_sales.csv"
)

df["OrderDate"] = pd.to_datetime(
    df["OrderDate"]
)

sales = df.groupby(
    "OrderDate"
)["Revenue"].sum()

model = ARIMA(
    sales,
    order=(5,1,0)
)

model_fit = model.fit()

forecast = model_fit.forecast(
    steps=365
)

forecast.to_csv(
    "outputs/sales_forecast.csv"
)

print("Forecast complete")
```

